AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional generic coding-agent command.
# If AGENT_COMMAND is set, AI Code Manager uses it instead of the built-in Codex runner.
# The command should read the task prompt from stdin and write the required result JSON.
# Available placeholders: {target_repo}, {project_root}, {workspace}, {manager_root}
AGENT_COMMAND=

# Built-in default runner.
# Used only when AGENT_COMMAND is blank.
CODEX_COMMAND=codex
